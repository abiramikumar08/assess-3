# ── IncuBrix PS3 B-Roll Video Engine Configuration ──

# Storage
OUTPUT_DIR=outputs

# Queue & Cache
REDIS_URL=redis://localhost:6379/0

# Footage Provider ("mock" | "pexels")
# "mock" requires no API key or internet, generates synthetic color test assets
FOOTAGE_PROVIDER=mock
PEXELS_API_KEY=

# Text-To-Speech Provider ("mock" | "sapi")
# "mock" produces synthetic silent WAV for testing without external dependencies
# "sapi" uses local Windows speech synthesizer
TTS_PROVIDER=mock
TTS_LANGUAGE=en

# Encoding settings
VIDEO_FPS=30
VIDEO_RESOLUTION_16_9=1280x720
VIDEO_RESOLUTION_9_16=720x1280
VIDEO_RESOLUTION_1_1=720x720

# Limits
MAX_AUDIO_SECONDS=600

# Optional custom FFmpeg path
FFMPEG_BIN=
